---
const { titul, popis } = Astro.props;
---
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titul}</title>
    <meta name="description" content={popis} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <slot />
    <style is:global>
      :root {
        --pozadi: #fbfaf7; --text: #1c1b19; --slabe: #6b675f; --linka: #e4e0d8;
        --karta: #fff; --ok: #2f7d52; --ne: #b4462f; --pul: #b07d1e; --zas: #5a4bbf;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --pozadi: #16151a; --text: #eceaf2; --slabe: #a5a1ae; --linka: #2d2b33;
          --karta: #1e1d23; --ok: #5fc98a; --ne: #f08a6e; --pul: #e2b558; --zas: #a695ff;
          color-scheme: dark;
        }
      }
      :root[data-theme="dark"] {
        --pozadi: #16151a; --text: #eceaf2; --slabe: #a5a1ae; --linka: #2d2b33;
        --karta: #1e1d23; --ok: #5fc98a; --ne: #f08a6e; --pul: #e2b558; --zas: #a695ff;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--pozadi); color: var(--text);
        font: 17px/1.7 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        padding: 0 20px 72px; -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      .obal { max-width: 720px; margin: 0 auto; }
      .znacka {
        text-transform: uppercase; letter-spacing: 0.08em; font-weight: 650;
        font-size: 11.5px; font-variant-numeric: tabular-nums;
      }
      .ok .znacka, .znacka.ok { color: var(--ok); }
      .ne .znacka, .znacka.ne { color: var(--ne); }
      .pul .znacka, .znacka.pul { color: var(--pul); }
      .zas .znacka, .znacka.zas { color: var(--zas); }
    </style>
  </body>
</html>
