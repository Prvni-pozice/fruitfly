---
import Zaklad from "../layouts/Zaklad.astro";
import pokusy from "../data/pokusy.json";
import Upoutavky from "../components/Upoutavky.astro";

const znacky = {
  ano: { text: "vyšlo", barva: "ok" },
  ne: { text: "nevyšlo", barva: "ne" },
  castecne: { text: "napůl", barva: "pul" },
  varovani: { text: "varování", barva: "pul" },
  zasadni: { text: "zásadní nález", barva: "zas" },
};

/* Ikonka pro kartičku bez videa — kreslí průběh pokusu, ne dekoraci:
   stoupající čára = vyšlo, padající = nevyšlo, rozdvojená = napůl,
   vykřičník = varování, hvězda = zásadní nález. */
const ikony = {
  ano: "M3 17 L9 11 L13 14 L21 5",
  ne: "M3 6 L9 12 L13 9 L21 19",
  castecne: "M3 12 L10 12 L15 6 M10 12 L15 18",
  varovani: "M12 4 L12 14 M12 18 L12 19.5",
  zasadni: "M12 3 L14.4 9.2 L21 9.6 L15.9 13.9 L17.5 20.4 L12 16.8 L6.5 20.4 L8.1 13.9 L3 9.6 L9.6 9.2 Z",
};
const razene = [...pokusy].reverse();
const pocet = {
  ano: pokusy.filter((p) => p.vysledek === "ano").length,
  ne: pokusy.filter((p) => p.vysledek === "ne").length,
  jine: pokusy.filter((p) => !["ano", "ne"].includes(p.vysledek)).length,
};
---

<Zaklad
  titul="fruitfly — učíme octomilku hrát hru"
  popis="Simulujeme celý mozek octomilky z connectomu FlyWire a snažíme se ho naučit hrát. Deník toho, co vyšlo a co ne."
>
  <header class="obal">
    <p class="mini">deník jednoho serveru</p>
    <h1>Učíme octomilku hrát hru</h1>
    <p class="perex">
      Vědci zveřejnili kompletní mapu zapojení mozku octomilky — <strong
        >všech 138 584 neuronů</strong
      > a každý jejich spoj. Stáhli jsme si ji, pustili na serveru a snažíme se z
      ní dostat chování. Tohle je zápis toho, co vyšlo. A hlavně toho, co ne.
    </p>
    <p class="hrat"><a href="/hra/">▸ Zahrát si s mouchou</a></p>
    <ul class="skore">
      <li><b>{pocet.ano}</b> vyšlo</li>
      <li><b>{pocet.ne}</b> nevyšlo</li>
      <li><b>{pocet.jine}</b> něco mezi</li>
    </ul>
  </header>

  <main class="obal">
    <Upoutavky ids={["mozek-nabehl", "falesny-poplach", "jeden-parametr"]} />

    <section class="pravidla">
      <h2>Tři pravidla, kterých se držíme</h2>
      <ol>
        <li>
          <b>Predikce se píšou předem</b> — včetně toho, co bude znamenat, že
          jsme se spletli. Jinak si výsledek vždycky nějak vysvětlíme.
        </li>
        <li>
          <b>Ke každému pokusu placebo.</b> Rameno, kde zasáhneme stejně silně, ale
          bez obsahu. Několikrát nás zachránilo od ostudy.
        </li>
        <li>
          <b>Jeden pokus není pokus.</b> Minimálně dvacet opakování. Proč, o tom
          je druhý článek zdola.
        </li>
      </ol>
    </section>

    <ol class="denik">
      {
        razene.map((p) => (
          <li class={`karta ${znacky[p.vysledek].barva}`}>
            <a href={`/pokus/${p.id}/`}>
              <div class="nahled">
                {p.video ? (
                  <>
                    <video
                      src={`${p.video.soubor}#t=0.5`}
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      aria-hidden="true"
                    />
                    <span class="odznak">video</span>
                  </>
                ) : (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d={ikony[p.vysledek]}
                      fill={p.vysledek === "zasadni" ? "currentColor" : "none"}
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    {p.vysledek === "varovani" && (
                      <path
                        d="M12 2 L22 20 L2 20 Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linejoin="round"
                        opacity="0.45"
                      />
                    )}
                  </svg>
                )}
              </div>
              <div class="obsah">
                <div class="hlava">
                  <span class="datum">{p.datum}</span>
                  <span class="znacka">{znacky[p.vysledek].text}</span>
                </div>
                <h3>{p.nazev}</h3>
                <p class="podtitul">{p.podtitul}</p>
                <p class="shrnuti">{p.shrnuti}</p>
                <span class="vic">Číst celé →</span>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </main>

  <footer class="obal">
    <p>
      Mozek: <a href="https://codex.flywire.ai/">FlyWire</a> v783 · zrak:
      <a href="https://github.com/TuragaLab/flyvis">flyvis</a> (Nature 2024) ·
      simulace podle Shiu et al. 2024 · kód na
      <a href="https://github.com/Prvni-pozice/fruitfly">GitHubu</a>
    </p>
    <p class="drobne">
      Nic z toho neznamená, že v serveru bydlí moucha. Znamená to, že v něm běží
      model jejího zapojení — a ten se chová překvapivě mouše podobně.
    </p>
  </footer>

  <script>
    // Náhled v kartičce se rozběhne při najetí myší a po odjetí se vrátí
    // na první snímek. Kdo má vypnuté animace, dostane statický obrázek.
    const klid = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!klid) {
      document.querySelectorAll(".karta .nahled video").forEach((v) => {
        const karta = v.closest(".karta");
        karta.addEventListener("mouseenter", () => v.play().catch(() => {}));
        karta.addEventListener("mouseleave", () => {
          v.pause();
          v.currentTime = 0.5;
        });
      });
    }
  </script>

  <style>
    header { padding: 72px 0 40px; border-bottom: 1px solid var(--linka); }
    .mini { font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.14em; font-size: 12px; color: var(--akcent); margin: 0 0 12px; }
    h1 { font-size: clamp(32px, 6.5vw, 50px); line-height: 1.1; margin: 0 0 20px; letter-spacing: -0.025em; }
    .perex { font-size: 19px; color: var(--slabe); margin: 0 0 28px; max-width: 58ch; }
    .perex strong { color: var(--text); }
    .hrat { margin: 0 0 26px; font-size: 16px; }
    .hrat a {
      display: inline-block; text-decoration: none; padding: 9px 16px;
      border: 1px solid var(--akcent); border-radius: 8px; color: var(--akcent);
    }
    .hrat a:hover { background: var(--akcent); color: var(--n-0); }
    .skore { list-style: none; display: flex; gap: 28px; padding: 0; margin: 0; font-size: 13px; color: var(--slabe); }
    .skore b { display: block; font-family: var(--mono); font-size: 28px; color: var(--text); font-variant-numeric: tabular-nums; line-height: 1.2; }
    h2 { font-size: 21px; margin: 48px 0 14px; letter-spacing: -0.015em; }
    .pravidla ol { padding-left: 22px; margin: 0; }
    .pravidla li { margin-bottom: 10px; color: var(--slabe); }
    .pravidla li b { color: var(--text); }
    .denik { list-style: none; padding: 0; margin: 44px 0 0; display: grid; gap: 14px; }
    .karta { background: var(--karta); border: 1px solid var(--linka); border-left: 3px solid var(--slabe); border-radius: 10px; transition: transform .12s ease, border-color .12s ease; }
    .karta:hover { transform: translateY(-2px); }
    .karta.ok { border-left-color: var(--ok); }
    .karta.ne { border-left-color: var(--ne); }
    .karta.pul { border-left-color: var(--pul); }
    .karta.zas { border-left-color: var(--zas); }
    .karta a {
      display: grid; grid-template-columns: 132px 1fr; gap: 18px;
      padding: 18px 20px; text-decoration: none; color: inherit; align-items: start;
    }
    .nahled {
      position: relative; aspect-ratio: 4 / 3; border-radius: 8px; overflow: hidden;
      background: var(--pozadi); border: 1px solid var(--linka);
      display: grid; place-items: center;
    }
    .nahled video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .nahled svg { width: 44%; height: 44%; }
    .karta.ok .nahled svg { color: var(--ok); }
    .karta.ne .nahled svg { color: var(--ne); }
    .karta.pul .nahled svg { color: var(--pul); }
    .karta.zas .nahled svg { color: var(--zas); }
    .odznak {
      position: absolute; left: 6px; bottom: 6px;
      font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text);
      background: color-mix(in srgb, var(--karta) 88%, transparent);
      padding: 2px 6px; border-radius: 10px;
    }
    @media (max-width: 560px) {
      .karta a { grid-template-columns: 1fr; gap: 14px; }
      .nahled { aspect-ratio: 16 / 7; }
      .nahled svg { width: 18%; height: 60%; }
    }
    .hlava { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 8px; }
    .datum { font-family: var(--mono); font-size: 12px; color: var(--slabe); font-variant-numeric: tabular-nums; }
    .karta h3 { margin: 0 0 3px; font-size: 21px; letter-spacing: -0.02em; line-height: 1.25; }
    .podtitul { margin: 0 0 12px; color: var(--slabe); font-size: 15px; }
    .shrnuti { margin: 0 0 12px; }
    .vic { font-size: 14px; color: var(--akcent); }
    footer { margin-top: 60px; padding-top: 24px; border-top: 1px solid var(--linka); font-size: 14px; color: var(--slabe); }
    .drobne { font-size: 13px; opacity: 0.85; }
  </style>
</Zaklad>
