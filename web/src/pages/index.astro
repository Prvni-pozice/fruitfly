---
import pokusy from "../data/pokusy.json";

const znacky = {
  ano: { text: "vyšlo", barva: "ok" },
  ne: { text: "nevyšlo", barva: "ne" },
  castecne: { text: "napůl", barva: "pul" },
  varovani: { text: "varování", barva: "pul" },
  zasadni: { text: "zásadní nález", barva: "zas" },
};
const pocet = {
  ano: pokusy.filter((p) => p.vysledek === "ano").length,
  ne: pokusy.filter((p) => p.vysledek === "ne").length,
  jine: pokusy.filter((p) => !["ano", "ne"].includes(p.vysledek)).length,
};
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>fruitfly — deník pokusů s mozkem octomilky</title>
    <meta
      name="description"
      content="Simulujeme celý mozek octomilky z connectomu FlyWire a snažíme se ho naučit hrát hru. Deník toho, co vyšlo a co ne."
    />
  </head>
  <body>
    <header>
      <p class="nadpis-mini">deník jednoho VPS</p>
      <h1>Učíme octomilku hrát hru</h1>
      <p class="perex">
        Vzali jsme zveřejněnou mapu <strong>všech 138 584 neuronů</strong> mozku
        octomilky, rozběhli ji na jednom serveru a snažíme se z ní dostat
        chování. Tohle je poctivý zápis toho, co vyšlo — a hlavně toho, co ne.
      </p>
      <ul class="skore">
        <li><b>{pocet.ano}</b> vyšlo</li>
        <li><b>{pocet.ne}</b> nevyšlo</li>
        <li><b>{pocet.jine}</b> něco mezi</li>
      </ul>
    </header>

    <main>
      <section class="pravidla">
        <h2>Tři pravidla, kterých se držíme</h2>
        <ol>
          <li>
            <b>Predikce se píšou předem.</b> Včetně toho, co bude znamenat, že
            jsme se spletli. Jinak si výsledek vždycky nějak vysvětlíme.
          </li>
          <li>
            <b>Ke každému pokusu placebo.</b> Rameno, kde zasáhneme stejně
            silně, ale bez obsahu. Několikrát nám zachránilo ostudu.
          </li>
          <li>
            <b>Jeden pokus není pokus.</b> Minimálně dvacet opakování. Viz
            druhý řádek níž.
          </li>
        </ol>
      </section>

      <ol class="denik">
        {
          pokusy.map((p) => (
            <li class={`karta ${znacky[p.vysledek].barva}`}>
              <div class="hlava">
                <span class="datum">{p.datum}</span>
                <span class="znacka">{znacky[p.vysledek].text}</span>
              </div>
              <h3>{p.nazev}</h3>
              <p class="otazka">{p.otazka}</p>
              <p class="text">{p.text}</p>
              <p class="cisla">{p.cisla}</p>
            </li>
          ))
        }
      </ol>

      <section class="pravidla">
        <h2>Co dál</h2>
        <p>
          Moucha vidí a umí zatáčet. Neumí se ale zlepšovat, když odměna přijde
          se zpožděním — a to je přesně to, co hra vyžaduje. Další na řadě je
          pevná sada hodnoticích epizod, ať vůbec poznáme, jestli se zlepšuje
          ona, nebo jen naše měřítko.
        </p>
      </section>
    </main>

    <footer>
      <p>
        Mozek: <a href="https://codex.flywire.ai/">FlyWire</a> v783 · zrak:
        <a href="https://github.com/TuragaLab/flyvis">flyvis</a> (Nature 2024) ·
        simulace podle Shiu et al. 2024
      </p>
      <p class="drobne">
        Nic z toho neznamená, že v serveru bydlí moucha. Znamená to, že v něm
        běží model jejího zapojení — a ten se chová překvapivě mouše podobně.
      </p>
    </footer>

    <style>
      :root {
        --pozadi: #fbfaf7;
        --text: #1c1b19;
        --slabe: #6b675f;
        --linka: #e4e0d8;
        --karta: #fff;
        --ok: #2f7d52;
        --ne: #b4462f;
        --pul: #b07d1e;
        --zas: #5a4bbf;
        color-scheme: light;
      }
      :root:not([data-theme="light"]) {
        @media (prefers-color-scheme: dark) {
          --pozadi: #16151a;
          --text: #eceaf2;
          --slabe: #a5a1ae;
          --linka: #2d2b33;
          --karta: #1e1d23;
          --ok: #5fc98a;
          --ne: #f08a6e;
          --pul: #e2b558;
          --zas: #a695ff;
          color-scheme: dark;
        }
      }
      :root[data-theme="dark"] {
        --pozadi: #16151a;
        --text: #eceaf2;
        --slabe: #a5a1ae;
        --linka: #2d2b33;
        --karta: #1e1d23;
        --ok: #5fc98a;
        --ne: #f08a6e;
        --pul: #e2b558;
        --zas: #a695ff;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--pozadi);
        color: var(--text);
        font: 16px/1.65 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        padding: 0 20px 64px;
      }
      header, main, footer { max-width: 760px; margin: 0 auto; }
      header { padding: 64px 0 40px; border-bottom: 1px solid var(--linka); }
      .nadpis-mini {
        text-transform: uppercase; letter-spacing: 0.14em;
        font-size: 12px; color: var(--slabe); margin: 0 0 12px;
      }
      h1 { font-size: clamp(30px, 6vw, 46px); line-height: 1.12; margin: 0 0 18px; letter-spacing: -0.02em; }
      .perex { font-size: 18px; color: var(--slabe); margin: 0 0 26px; max-width: 58ch; }
      .perex strong { color: var(--text); }
      .skore { list-style: none; display: flex; gap: 26px; padding: 0; margin: 0; font-size: 14px; color: var(--slabe); }
      .skore b { display: block; font-size: 26px; color: var(--text); font-variant-numeric: tabular-nums; }
      h2 { font-size: 20px; margin: 44px 0 14px; letter-spacing: -0.01em; }
      .pravidla ol { padding-left: 20px; margin: 0; }
      .pravidla li { margin-bottom: 10px; color: var(--slabe); }
      .pravidla li b { color: var(--text); }
      .pravidla p { color: var(--slabe); max-width: 60ch; }
      .denik { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 16px; }
      .karta {
        background: var(--karta); border: 1px solid var(--linka);
        border-left: 3px solid var(--slabe); border-radius: 10px; padding: 18px 20px;
      }
      .karta.ok { border-left-color: var(--ok); }
      .karta.ne { border-left-color: var(--ne); }
      .karta.pul { border-left-color: var(--pul); }
      .karta.zas { border-left-color: var(--zas); }
      .hlava { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 8px; }
      .datum, .znacka { font-size: 12px; font-variant-numeric: tabular-nums; }
      .datum { color: var(--slabe); }
      .znacka { text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }
      .ok .znacka { color: var(--ok); }
      .ne .znacka { color: var(--ne); }
      .pul .znacka { color: var(--pul); }
      .zas .znacka { color: var(--zas); }
      .karta h3 { margin: 0 0 4px; font-size: 19px; letter-spacing: -0.01em; }
      .otazka { margin: 0 0 10px; color: var(--slabe); font-style: italic; }
      .text { margin: 0 0 12px; }
      .cisla {
        margin: 0; font-family: ui-monospace, "SF Mono", Menlo, monospace;
        font-size: 13px; color: var(--slabe);
        border-top: 1px dashed var(--linka); padding-top: 10px;
      }
      footer { margin-top: 56px; padding-top: 22px; border-top: 1px solid var(--linka); font-size: 14px; color: var(--slabe); }
      footer a { color: inherit; }
      .drobne { font-size: 13px; opacity: 0.8; }
    </style>
  </body>
</html>
